# =====================================================================
# .env.example — DOC (MDR Advocacia)
# Copie para .env (nunca commite o .env real) ou cole no painel do
# Coolify em "Environment Variables" do serviço.
# =====================================================================

# --- Django ---
# Gerar com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave

# Em produção: DEBUG=False (qualquer outro valor = False).
DEBUG=False

# Hosts aceitos pelo Django. Lista separada por vírgula.
ALLOWED_HOSTS=doc.mdradvocacia.com,doc-lab.mdradvocacia.com

# Origens permitidas para POST/CSRF (precisa do esquema https://).
CSRF_TRUSTED_ORIGINS=https://doc.mdradvocacia.com,https://doc-lab.mdradvocacia.com

# --- Proxy reverso (Traefik no Coolify) ---
# True = liga SECURE_PROXY_SSL_HEADER, USE_X_FORWARDED_HOST,
# SESSION_COOKIE_SECURE e CSRF_COOKIE_SECURE.
DJANGO_SECURE_PROXY=True

# --- Hardening adicional (P3) ---
# Só ligar depois de validar que TUDO trafega via HTTPS.
# HSTS é "via única" — comece com 3600 (1h) e suba aos poucos.
DJANGO_HARDENING=False
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# --- Banco de dados ---
POSTGRES_DB=DOC
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

DB_NAME=DOC
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_HOST=db
DB_PORT=5432

# --- Email (opcional) ---
# Sem EMAIL_HOST: em DEBUG vai para console; em prod vira "dummy".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DOC <noreply@mdradvocacia.com>

# --- Gunicorn (opcional) ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Calculadora / IA ---
CALCULO_LLM_API_KEY=
CALCULO_LLM_API_URL=https://api.openai.com/v1/chat/completions
CALCULO_LLM_MODEL=gpt-5.4-nano

# --- Anthropic Claude (sugestão automática de modelos) ---
# Obtenha em https://console.anthropic.com → Settings → API Keys
# Se vazio, a funcionalidade "Sugerir com IA" fica oculta no UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
